{
  "name": "gridline-excel-addin",
  "version": "1.0.0",
  "private": true,
  "description": "Gridline — Excel add-in: import CRM deals into a sheet, clean data, custom functions, PDF invoices and two-way sync.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build",
    "demo": "vite build --config vite.demo.config.ts",
    "start": "office-addin-debugging start manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": { "jspdf": "^2.5.2", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": {
    "@types/custom-functions-runtime": "^1.6.9",
    "@types/office-js": "^1.0.450",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
