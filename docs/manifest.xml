<?xml version="1.0" encoding="UTF-8"?>
<!-- Gridline — Excel add-in manifest (add-in only XML manifest).
     Generated for https://fg5y4rp8nh-sys.github.io/gridline-excel-addin. For production point every URL at your own HTTPS host. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>50f0deaf-47d5-497b-a346-3a32a2aba66a</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Your Company</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Gridline"/>
  <Description DefaultValue="Import CRM deals into Excel, clean the data, use live custom functions, create PDF invoices and push edits back to the CRM."/>
  <IconUrl DefaultValue="https://fg5y4rp8nh-sys.github.io/gridline-excel-addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://fg5y4rp8nh-sys.github.io/gridline-excel-addin/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.your-company.com/support"/>
  <AppDomains>
    <AppDomain>https://api.your-crm.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.7"/>
      <Set Name="SharedRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://fg5y4rp8nh-sys.github.io/gridline-excel-addin/taskpane/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <!-- One shared runtime: the task pane, custom functions and ribbon commands run in the same page. -->
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script><SourceLocation resid="Functions.Script"/></Script>
            <Page><SourceLocation resid="Taskpane.Url"/></Page>
            <Metadata><SourceLocation resid="Functions.Metadata"/></Metadata>
            <Namespace resid="Functions.Namespace"/>
          </ExtensionPoint>
        </AllFormFactors>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMore"/>
          </GetStarted>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="Gridline.Tab">
              <Group id="Grp.Pane">
                <Label resid="Grp.Pane.Label"/>
                <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
              <Control xsi:type="Button" id="Btn.Open">
                <Label resid="Btn.Open.Label"/>
                <Supertip><Title resid="Btn.Open.Label"/><Description resid="Btn.Open.Tip"/></Supertip>
                <Icon><bt:Image size="16" resid="I.open.16"/><bt:Image size="32" resid="I.open.32"/><bt:Image size="80" resid="I.open.80"/></Icon>
                <Action xsi:type="ShowTaskpane"><TaskpaneId>GridlinePane</TaskpaneId><SourceLocation resid="Taskpane.Url"/></Action>
              </Control>
              </Group>
              <Group id="Grp.Data">
                <Label resid="Grp.Data.Label"/>
                <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
              <Control xsi:type="Button" id="Btn.Import">
                <Label resid="Btn.Import.Label"/>
                <Supertip><Title resid="Btn.Import.Label"/><Description resid="Btn.Import.Tip"/></Supertip>
                <Icon><bt:Image size="16" resid="I.import.16"/><bt:Image size="32" resid="I.import.32"/><bt:Image size="80" resid="I.import.80"/></Icon>
                <Action xsi:type="ExecuteFunction"><FunctionName>openImport</FunctionName></Action>
              </Control>
              <Control xsi:type="Button" id="Btn.Clean">
                <Label resid="Btn.Clean.Label"/>
                <Supertip><Title resid="Btn.Clean.Label"/><Description resid="Btn.Clean.Tip"/></Supertip>
                <Icon><bt:Image size="16" resid="I.clean.16"/><bt:Image size="32" resid="I.clean.32"/><bt:Image size="80" resid="I.clean.80"/></Icon>
                <Action xsi:type="ExecuteFunction"><FunctionName>openClean</FunctionName></Action>
              </Control>
              <Control xsi:type="Button" id="Btn.Functions">
                <Label resid="Btn.Functions.Label"/>
                <Supertip><Title resid="Btn.Functions.Label"/><Description resid="Btn.Functions.Tip"/></Supertip>
                <Icon><bt:Image size="16" resid="I.fx.16"/><bt:Image size="32" resid="I.fx.32"/><bt:Image size="80" resid="I.fx.80"/></Icon>
                <Action xsi:type="ExecuteFunction"><FunctionName>openFormulas</FunctionName></Action>
              </Control>
              <Control xsi:type="Button" id="Btn.QuickClean">
                <Label resid="Btn.QuickClean.Label"/>
                <Supertip><Title resid="Btn.QuickClean.Label"/><Description resid="Btn.QuickClean.Tip"/></Supertip>
                <Icon><bt:Image size="16" resid="I.quick.16"/><bt:Image size="32" resid="I.quick.32"/><bt:Image size="80" resid="I.quick.80"/></Icon>
                <Action xsi:type="ExecuteFunction"><FunctionName>cleanSheet</FunctionName></Action>
              </Control>
              </Group>
              <Group id="Grp.Crm">
                <Label resid="Grp.Crm.Label"/>
                <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
              <Control xsi:type="Button" id="Btn.Invoice">
                <Label resid="Btn.Invoice.Label"/>
                <Supertip><Title resid="Btn.Invoice.Label"/><Description resid="Btn.Invoice.Tip"/></Supertip>
                <Icon><bt:Image size="16" resid="I.invoice.16"/><bt:Image size="32" resid="I.invoice.32"/><bt:Image size="80" resid="I.invoice.80"/></Icon>
                <Action xsi:type="ExecuteFunction"><FunctionName>openInvoice</FunctionName></Action>
              </Control>
              <Control xsi:type="Button" id="Btn.Sync">
                <Label resid="Btn.Sync.Label"/>
                <Supertip><Title resid="Btn.Sync.Label"/><Description resid="Btn.Sync.Tip"/></Supertip>
                <Icon><bt:Image size="16" resid="I.sync.16"/><bt:Image size="32" resid="I.sync.32"/><bt:Image size="80" resid="I.sync.80"/></Icon>
                <Action xsi:type="ExecuteFunction"><FunctionName>openSync</FunctionName></Action>
              </Control>
              </Group>
              <Label resid="Tab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://fg5y4rp8nh-sys.github.io/gridline-excel-addin/assets/icon-16.png"/>
